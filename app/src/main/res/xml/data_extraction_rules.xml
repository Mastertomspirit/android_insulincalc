<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Security: Exclude encrypted database and security keys from cloud backup -->
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="insulin_calc_secure_vault.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Security: Hardware KeyStore keys cannot be transferred to other devices -->
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="insulin_calc_secure_vault.xml" />
    </device-transfer>
</data-extraction-rules>
